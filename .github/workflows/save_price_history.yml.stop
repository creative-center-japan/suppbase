name: Save Price History

on:
  schedule:
    - cron: '0 0 * * *' # 毎日 9:00 JST
  workflow_dispatch:

jobs:
  save:
    runs-on: ubuntu-latest
    steps:
      - name: Save price history
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
        run: |
          psql "$DATABASE_URL" << 'SQL'
          insert into product_price_history (asin, buyboxprice)
          select asin, buyboxprice
          from products
          where buyboxprice > 0;
          SQL
